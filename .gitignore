# Build outputs (top-level Debug/Release/bin/obj). Note: the `debug` module at
# MonoDreams/debug/ is intentionally NOT ignored — runtime debug *output*
# lives under bin/, captured by the **/bin/**/debug/ rule further down.
/[Bb]in/
/[Oo]bj/
/[Rr]elease/
/MonoDreams/[Bb]in/
/MonoDreams/[Oo]bj/
/MonoDreams/[Rr]elease/
/MonoDreams.Examples/[Bb]in/
/MonoDreams.Examples/[Oo]bj/
/MonoDreams.Examples/[Dd]ebug/
/MonoDreams.Examples/[Rr]elease/
/MonoDreams.Tests/[Bb]in/
/MonoDreams.Tests/[Oo]bj/
/MonoDreams.Tests/[Dd]ebug/
/MonoDreams.Tests/[Rr]elease/
/MonoDreams.YarnSpinner/[Bb]in/
/MonoDreams.YarnSpinner/[Oo]bj/
/MonoDreams.YarnSpinner/[Dd]ebug/
/MonoDreams.YarnSpinner/[Rr]elease/
/MonoDreams.Demos/[Bb]in/
/MonoDreams.Demos/[Oo]bj/
/MonoDreams.Demos/[Dd]ebug/
/MonoDreams.Demos/[Rr]elease/

# Catch-all for any project's build dirs (e.g. MonoDreams.Cli) so newly
# added projects never re-track obj/bin. The debug *source* module lives at
# MonoDreams/debug/ (not under obj/bin) and is unaffected.
**/[Bb]in/
**/[Oo]bj/

# Debug output (screenshots, logs, replay files) — inside build output directories only
**/bin/**/debug/

# Island placeholder art packs (itch.io licenses forbid redistribution; the repo is
# public). The committed MANIFEST.md documents what to download and the folder layout;
# the in-game editor's asset palette scans this folder at startup (runtime file loading,
# file: AssetKeys — no MGCB round-trip).
/MonoDreams.Examples.Core/Content/Island/**
!/MonoDreams.Examples.Core/Content/Island/MANIFEST.md

# NuGet
nuget/
*.nupkg
.nuget/

# MonoGame Content Pipeline build outputs
**/Content/bin/
**/Content/obj/
*.xnb

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

