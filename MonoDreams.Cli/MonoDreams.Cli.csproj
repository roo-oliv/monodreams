<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MonoDreams.Cli</RootNamespace>
    <AssemblyName>monodreams</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>monodreams</ToolCommandName>
    <PackageId>MonoDreams.Cli</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Rodrigo Oliveira</Authors>
    <Description>Code-first installer for the MonoDreams game engine. Copies engine source modules into your project, shadcn-style.</Description>
    <PackageTags>monodreams; monogame; cli; tool; game-engine</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>

    <IsPackable>true</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <!--
    The `migrate` / `migrate-colliders` commands share SOURCE with the engine rather than referencing it: the
    engine assembly is `MonoDreams.dll` and this tool's is `monodreams.dll`, which collide on a
    case-insensitive filesystem (see MonoDreams.Cli.Tests for the same rationale). Source-linking the
    DEPENDENCY-FREE serialization files (System.Text.Json only — no MonoGame/DefaultEcs) lets the migrators
    produce byte-canonical output through the SAME CanonicalJson policy the engine writes scenes with,
    guaranteeing parity without the DLL clash. These files must stay free of engine (MonoGame/DefaultEcs)
    types. SceneMigration is the umbrella that chains ColliderMigration (v1→v2) then CameraMigration (v2→v3).
  -->
  <ItemGroup>
    <Compile Include="..\MonoDreams\level-editor\Serialization\SceneData.cs" Link="Shared\SceneData.cs" />
    <Compile Include="..\MonoDreams\level-editor\Serialization\CanonicalJson.cs" Link="Shared\CanonicalJson.cs" />
    <Compile Include="..\MonoDreams\level-editor\Serialization\ColliderMigration.cs" Link="Shared\ColliderMigration.cs" />
    <Compile Include="..\MonoDreams\level-editor\Serialization\CameraMigration.cs" Link="Shared\CameraMigration.cs" />
    <Compile Include="..\MonoDreams\level-editor\Serialization\SceneMigration.cs" Link="Shared\SceneMigration.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonoDreams.Cli.Tests" />
  </ItemGroup>
</Project>
