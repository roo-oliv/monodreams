@page "/"
@page "/index.html"
@inject IJSRuntime JsRuntime
@using nkast.Wasm.Canvas

<PageTitle>MonoDreams Examples (BlazorGL)</PageTitle>

<div id="canvasHolder" style="
    background: #000;
    margin: 0%;
    position: fixed;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    width: 100vw;
    height: 100vh;
">
    <canvas id="theCanvas" style="touch-action:none; display:block; outline:none; width:100%; height:100%;"></canvas>
</div>
