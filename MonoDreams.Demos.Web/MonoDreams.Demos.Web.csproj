<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Demos.Web — the BlazorGL (KNI) head for the MonoDreams module demos.
    Mirrors MonoDreams.Examples.Web, but the demos are a single, additive web head: there is
    no Demos.Core split. The shared demo game code lives in MonoDreams.Demos (Screens/, UI/)
    and the per-module demo screens live under MonoDreams/<module>/demo/. This head
    compile-includes those sources directly (the SAME cross-compile pattern MonoDreams.Demos
    already uses for the module demos), so the desktop Demos project and its issue-#28 headless
    tests stay completely untouched. This head owns only the WASM host wiring (Program/App/
    Index/index.html), the WebGame entry, and the per-platform content build.

    BUILD IT WITH:  dotnet build MonoDreams.Demos.Web -p:MonoDreamsPlatform=web
    MonoDreamsPlatform=web must be a GLOBAL property (-p:) so it propagates through the engine
    reference graph at RESTORE time (AdditionalProperties on a ProjectReference does NOT flow to
    restore). Like Examples.Web, this head is excluded from the solution's default build so a
    plain `dotnet build monodreams.sln` (the desktop regression) never builds it without the
    property. Requires the `wasm-tools` dotnet workload.

    Content: the demos use a single BitmapFont (a .png texture + a .fnt) plus the audio demo's
    procedurally-generated .wav sound effects. No LDtk levels, no Yarn content (the dialogue
    demo runs in-memory), so the content build here needs only the BitmapFont pipeline
    (KNI.Extended.Content.Pipeline) + the built-in Texture/Wav importers (KNI's MGCB ships the
    audio pipeline in its tools dir — no /reference: needed) — no engine or LDtk
    content-pipeline dll, which is why this csproj's content section is much smaller than
    Examples.Web's.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The shared demo source (MonoDreams.Demos Screens/UI) is authored against implicit
         usings + nullable, so this head matches those to compile them unchanged. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MonoDreams.Demos.Web</RootNamespace>
    <AssemblyName>MonoDreams.Demos.Web</AssemblyName>
    <DefineConstants>$(DefineConstants);BLAZORGL;MONODREAMS_WEB</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared demo game code, compiled into this head (the module-demo cross-compile pattern).
         Only Screens/ + UI/ + the DemoEditor composition helper — NOT MonoDreams.Demos' desktop
         host (Game1/Program/HeadlessOptions), which this head replaces with WebGame + the Blazor
         host. DemoEditor.cs is required since every demo screen references it (the editor overlay
         seam; a plain web run never activates it — EditorRunFlag stays off). -->
    <Compile Include="..\MonoDreams.Demos\Screens\**\*.cs" LinkBase="Shared\Screens" />
    <Compile Include="..\MonoDreams.Demos\UI\**\*.cs" LinkBase="Shared\UI" />
    <Compile Include="..\MonoDreams.Demos\DemoEditor.cs" LinkBase="Shared" />
    <!-- Per-module demo screens (excluded from the engine dll's default glob). -->
    <Compile Include="..\MonoDreams\**\demo\**\*.cs" LinkBase="ModuleDemos" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine + the shared web-host layer, both built for the WEB backend (KNI).
         MonoDreamsPlatform=web must be a global property (-p:) for the restore to resolve the KNI
         packages transitively. The KNI runtime stack (nkast.* + Blazor.GL + KNI.Extended) is no
         longer listed here — it comes transitively through MonoDreams.Web.Hosting. -->
    <ProjectReference Include="..\MonoDreams\MonoDreams.csproj" />
    <ProjectReference Include="..\MonoDreams.Web.Hosting\MonoDreams.Web.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- =====================================================================================
       Per-platform content build: the demos' Content.mgcb (lives in MonoDreams.Demos),
       built for /platform:BlazorGL by the KNI builder. The demos' content is a BitmapFont
       (Texture + .fnt) + the audio demo's .wav sound effects (WavImporter/SoundEffectProcessor
       are built into the KNI MGCB), so this needs just KNI.Extended.Content.Pipeline and the
       macOS/Linux native-lib shim for the TextureImporter — no engine/LDtk pipeline dll.
       ===================================================================================== -->
  <PropertyGroup>
    <KniBuilderPkg>$(NuGetPackageRoot)nkast.xna.framework.content.pipeline.builder/4.2.9001</KniBuilderPkg>
    <KniBuilderToolsDir>$(KniBuilderPkg)/tools</KniBuilderToolsDir>
    <MonoGameMgcbToolDir>$(NuGetPackageRoot)dotnet-mgcb/3.8.4/tools/net8.0/any/runtimes/osx/native</MonoGameMgcbToolDir>
    <MonoGameMgcbToolDirLinux>$(NuGetPackageRoot)dotnet-mgcb/3.8.4/tools/net8.0/any/runtimes/linux-x64/native</MonoGameMgcbToolDirLinux>
    <!-- Run MGCB cross-platform via the managed entrypoint instead of the bundled Windows .exe. -->
    <KniContentBuilderExe Condition="'$(OS)' != 'Windows_NT'">dotnet</KniContentBuilderExe>
  </PropertyGroup>

  <!-- The KNI content-builder + extended pipeline are dev-time only (run MGCB on the dev's
       desktop); reference them for the restore + tools, but keep their assets out of the bundle. -->
  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001"
                      ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="KNI.Extended.Content.Pipeline" Version="6.0.0"
                      ExcludeAssets="all" GeneratePathProperty="true" />
    <!-- The desktop MonoGame MGCB tool, DOWNLOADED (not referenced — it is a DotnetTool package,
         which PackageReference rejects) purely so the shim target below can borrow its
         macOS/Linux native libs + ffmpeg/ffprobe out of $(NuGetPackageRoot)dotnet-mgcb/3.8.4/.
         Every borrow below is Exists()-guarded, so without this download they all silently no-op
         on a machine that never built desktop content — and the first texture/.wav then fails the
         content build with DllNotFoundException / "not DRM protected". Keep the version equal to
         the dotnet-mgcb/<version> path literals above and in the target below. -->
    <PackageDownload Include="dotnet-mgcb" Version="[3.8.4]" />
  </ItemGroup>

  <!-- Import the KNI content-builder targets (CollectContentReferences / RunContentBuilder /
       IncludeContent). The .targets auto-globs **/*.mgcb under THIS project; ours lives in
       MonoDreams.Demos, so we add it explicitly as a KniContentReference below. -->
  <Import Project="$(KniBuilderPkg)/build/nkast.Xna.Framework.Content.Pipeline.Builder.targets"
          Condition="Exists('$(KniBuilderPkg)/build/nkast.Xna.Framework.Content.Pipeline.Builder.targets')" />

  <ItemGroup>
    <!-- The demos' Content.mgcb (lives in MonoDreams.Demos). The Link's directory name becomes
         the ContentFolder, so output lands in wwwroot/Content/ for the BlazorGL platform. -->
    <KniContentReference Include="..\MonoDreams.Demos\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </KniContentReference>
  </ItemGroup>

  <!-- Stage the cross-platform native libs + set the /reference: args before MGCB runs. -->
  <Target Name="PrepareKniContentNativeShim" BeforeTargets="RunContentBuilder">
    <PropertyGroup>
      <_ExtendedPipelineDll>$(PkgKNI_Extended_Content_Pipeline)/lib/net8.0/KNI.Extended.Content.Pipeline.dll</_ExtendedPipelineDll>
      <_ExtendedRuntimeDll>$(NuGetPackageRoot)kni.extended/6.0.0/lib/net8.0/KNI.Extended.dll</_ExtendedRuntimeDll>
      <_AutofacDll>$(NuGetPackageRoot)autofac/5.2.0/lib/netstandard2.1/Autofac.dll</_AutofacDll>
      <!-- Run the managed MGCB.dll on non-Windows; the .targets default is the Windows MGCB.exe. -->
      <KniContentBuilderArguments Condition="'$(OS)' != 'Windows_NT'">"$(KniBuilderToolsDir)/MGCB.dll" /quiet /reference:"$(_ExtendedPipelineDll)"</KniContentBuilderArguments>
      <KniContentBuilderArguments Condition="'$(OS)' == 'Windows_NT'">/quiet /reference:"$(_ExtendedPipelineDll)"</KniContentBuilderArguments>
    </PropertyGroup>

    <!-- The KNI builder's importer-dependency probing loads referenced assemblies from the
         tools dir; stage KNI.Extended runtime + Autofac there so the BitmapFont importer resolves. -->
    <Copy SourceFiles="$(_ExtendedRuntimeDll)" DestinationFolder="$(KniBuilderToolsDir)"
          SkipUnchangedFiles="true" Condition="Exists('$(_ExtendedRuntimeDll)')" />
    <Copy SourceFiles="$(_ExtendedPipelineDll)" DestinationFolder="$(KniBuilderToolsDir)"
          SkipUnchangedFiles="true" Condition="Exists('$(_ExtendedPipelineDll)')" />
    <Copy SourceFiles="$(_AutofacDll)" DestinationFolder="$(KniBuilderToolsDir)"
          SkipUnchangedFiles="true" Condition="Exists('$(_AutofacDll)')" />

    <!-- macOS/Linux native-lib shim for the TextureImporter (FreeImage/freetype). The KNI builder
         package ships only Windows DLLs; borrow the matching native libs from the desktop MonoGame
         MGCB tool (dotnet-mgcb), renamed to the names the KNI P/Invoke probes (FreeImage / freetype6). -->
    <Copy SourceFiles="$(MonoGameMgcbToolDir)/libfreeimage.dylib" DestinationFiles="$(KniBuilderToolsDir)/FreeImage.dylib"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT' AND Exists('$(MonoGameMgcbToolDir)/libfreeimage.dylib')" />
    <Copy SourceFiles="$(MonoGameMgcbToolDir)/libfreetype.dylib" DestinationFiles="$(KniBuilderToolsDir)/freetype6.dylib"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT' AND Exists('$(MonoGameMgcbToolDir)/libfreetype.dylib')" />
    <Copy SourceFiles="$(MonoGameMgcbToolDirLinux)/libfreeimage.so" DestinationFiles="$(KniBuilderToolsDir)/FreeImage.so"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT' AND Exists('$(MonoGameMgcbToolDirLinux)/libfreeimage.so')" />

    <!-- Audio shim (same borrow, different tool): KNI's WavImporter/SoundEffectProcessor shell out
         to ffprobe/ffmpeg via ExternalTool, which probes the builder's per-OS subdir next to
         MGCB.dll (osx/, linux-x64/, linux/, win-x64/, win-x86/ — binary strings in
         Xna.Framework.Content.Pipeline.Audio.dll 4.2.9001) and then PATH — and the KNI builder
         package ships NO ffmpeg for any OS. Borrow the binaries the desktop MonoGame MGCB tool
         bundles (dotnet-mgcb tools/net8.0/any/<os>/) into the subdir KNI probes, or the demos'
         .wav content fails with "Failed to open file ... not DRM protected". The Windows copy
         (windows-x64 ffmpeg.exe/ffprobe.exe into win-x64/) follows the exact same pattern but is
         untested on a real Windows host; if the borrow misses, ffmpeg/ffprobe on PATH is the
         fallback KNI probes (docs/web-targeting.md, shim step 5). -->
    <PropertyGroup>
      <MonoGameMgcbFfDirOsx>$(NuGetPackageRoot)dotnet-mgcb/3.8.4/tools/net8.0/any/osx</MonoGameMgcbFfDirOsx>
      <MonoGameMgcbFfDirLinux>$(NuGetPackageRoot)dotnet-mgcb/3.8.4/tools/net8.0/any/linux-x64</MonoGameMgcbFfDirLinux>
      <MonoGameMgcbFfDirWin>$(NuGetPackageRoot)dotnet-mgcb/3.8.4/tools/net8.0/any/windows-x64</MonoGameMgcbFfDirWin>
    </PropertyGroup>
    <Copy SourceFiles="$(MonoGameMgcbFfDirOsx)/ffmpeg;$(MonoGameMgcbFfDirOsx)/ffprobe"
          DestinationFolder="$(KniBuilderToolsDir)/osx"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT' AND Exists('$(MonoGameMgcbFfDirOsx)/ffprobe')" />
    <Copy SourceFiles="$(MonoGameMgcbFfDirLinux)/ffmpeg;$(MonoGameMgcbFfDirLinux)/ffprobe"
          DestinationFolder="$(KniBuilderToolsDir)/linux-x64"
          SkipUnchangedFiles="true" Condition="'$(OS)' != 'Windows_NT' AND Exists('$(MonoGameMgcbFfDirLinux)/ffprobe')" />
    <Copy SourceFiles="$(MonoGameMgcbFfDirWin)/ffmpeg.exe;$(MonoGameMgcbFfDirWin)/ffprobe.exe"
          DestinationFolder="$(KniBuilderToolsDir)/win-x64"
          SkipUnchangedFiles="true" Condition="'$(OS)' == 'Windows_NT' AND Exists('$(MonoGameMgcbFfDirWin)/ffprobe.exe')" />
  </Target>

</Project>
