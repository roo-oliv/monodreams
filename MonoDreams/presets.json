{
  "$schema": "./module.schema.json",
  "version": 1,
  "presets": [
    {
      "name": "ldtk-platformer",
      "description": "Full LDtk-driven platformer with dialogue, UI, cursor, and debug overlays (Level 1)",
      "platforms": ["desktop", "web"],
      "modules": [
        "foundation",
        "rendering",
        "rendering-text",
        "camera",
        "physics",
        "collision",
        "level-loading",
        "level-ldtk",
        "ui",
        "dialogue",
        "cursor",
        "debug"
      ]
    },
    {
      "name": "blender-platformer",
      "description": "Same as ldtk-platformer but loading Blender-exported levels (Level 2)",
      "platforms": ["desktop", "web"],
      "modules": [
        "foundation",
        "rendering",
        "rendering-text",
        "camera",
        "physics",
        "collision",
        "level-loading",
        "level-blender",
        "ui",
        "dialogue",
        "cursor",
        "debug"
      ]
    },
    {
      "name": "infinite-runner",
      "description": "Procedural shape-driven runner with no level files, no UI, no dialogue (Level 3)",
      "platforms": ["desktop", "web"],
      "modules": [
        "foundation",
        "rendering",
        "rendering-text",
        "physics",
        "collision",
        "debug"
      ]
    }
  ]
}
